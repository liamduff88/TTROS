{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTROS Prospect Ledger Record",
  "description": "Append-only full snapshots. Legacy daily-prospecting and outreach-pilot records share the canonical ledger.",
  "oneOf": [
    {"$ref": "#/definitions/legacy_daily_prospect"},
    {"$ref": "#/definitions/outreach_pilot"}
  ],
  "definitions": {
    "legacy_daily_prospect": {
      "type": "object",
      "required": [
        "prospect_id", "name", "company", "lane", "icp_variant",
        "signal_class", "signal_date", "signal_source_url", "source_query",
        "score", "tier", "readiness", "wedge", "angle_type",
        "first_touch_style", "outreach_basis", "status", "status_date",
        "touch_count", "next_touch_due", "entity_page_path", "do_not_contact"
      ],
      "properties": {
        "prospect_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "company": {"type": "string", "minLength": 1},
        "lane": {"type": "string", "enum": ["professional_services", "home_services_trades", "commercial_services", "property", "recruiting_hr_training", "icp_b_gtm"]},
        "icp_variant": {"type": "string", "enum": ["A", "B"]},
        "signal_class": {"type": "string", "enum": ["hiring_friction", "growth_event", "workflow_friction", "founder_voice", "stack_maturity"]},
        "signal_date": {"type": "string", "format": "date"},
        "signal_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_query": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "tier": {"type": "string", "enum": ["A", "B", "C_monitor", "D_reject"]},
        "readiness": {"type": "string", "enum": ["now", "near_term", "monitor"]},
        "wedge": {"type": "string", "minLength": 1},
        "angle_type": {"type": "string", "enum": ["signal_reference", "problem_question", "proof_point", "warm_context"]},
        "first_touch_style": {"type": "string", "enum": ["noted_request", "blank_request", "inmail", "email", "message_first"]},
        "outreach_basis": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/definitions/status"},
        "status_date": {"type": "string", "format": "date"},
        "touch_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "next_touch_due": {"type": ["string", "null"], "format": "date"},
        "outcome_notes": {"type": "string"},
        "entity_page_path": {"type": "string", "pattern": "^business_brain:prospects/[a-z0-9][a-z0-9/-]*\\.md$"},
        "do_not_contact": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "outreach_pilot": {
      "type": "object",
      "required": [
        "record_type", "pilot_version", "prospect_id", "name", "person_name",
        "company", "company_name", "company_domain", "related_entities", "role",
        "lane", "icp_variant", "source_handoff", "source_hash", "handoff_version",
        "signal_date", "signal_source_url", "score", "tier", "readiness",
        "qualification", "primary_signal", "main_caution", "status", "status_date",
        "touch_count", "next_touch_due", "outreach_channel", "outreach_stage",
        "next_action", "next_reminder", "last_contact_date", "reply_status",
        "outcome", "opt_out", "do_not_contact", "event_id", "latest_event",
        "outreach_history", "future_activity_cancelled", "sequence_copy",
        "reconciliation", "review_item_id", "gmail_draft_reference",
        "gmail_draft_url", "outcome_notes", "crm_dry_run"
      ],
      "properties": {
        "record_type": {"const": "outreach_pilot_v1"},
        "pilot_version": {"const": "1"},
        "prospect_id": {"type": "string", "pattern": "^TTR-[AB]-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "person_name": {"type": "string", "minLength": 1},
        "company": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "company_domain": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"},
        "related_entities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "role": {"type": "string", "minLength": 1},
        "lane": {"type": "string", "enum": ["professional_services", "home_services_trades", "commercial_services", "property", "recruiting_hr_training", "icp_b_gtm"]},
        "icp_variant": {"type": "string", "enum": ["A", "B"]},
        "source_handoff": {"type": "string", "minLength": 1},
        "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "handoff_version": {"const": "3.1"},
        "signal_date": {"type": "string", "format": "date"},
        "signal_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "tier": {"type": "string", "enum": ["A", "B", "C_monitor", "D_reject"]},
        "readiness": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1},
        "primary_signal": {"type": "string", "minLength": 1},
        "main_caution": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/definitions/status"},
        "status_date": {"type": "string", "format": "date"},
        "touch_count": {"type": "integer", "minimum": 0},
        "next_touch_due": {"type": ["string", "null"], "format": "date"},
        "outreach_channel": {"enum": ["email", "linkedin"]},
        "outreach_stage": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "next_reminder": {"type": ["object", "null"]},
        "last_contact_date": {"type": ["string", "null"], "format": "date"},
        "reply_status": {"type": "string"},
        "outcome": {"type": ["string", "null"]},
        "opt_out": {"type": "boolean"},
        "do_not_contact": {"type": "boolean"},
        "event_id": {"type": "string", "minLength": 1},
        "latest_event": {"type": "object"},
        "outreach_history": {"type": "array", "items": {"type": "object"}},
        "future_activity_cancelled": {"type": "boolean"},
        "sequence_copy": {"type": "object"},
        "reconciliation": {"type": "object"},
        "review_item_id": {"type": "string", "pattern": "^AOS-[0-9]{4}-[0-9]{4}$"},
        "gmail_draft_reference": {"type": ["string", "null"]},
        "gmail_draft_url": {"type": ["string", "null"], "format": "uri"},
        "outcome_notes": {"type": "string"},
        "crm_dry_run": {"type": "object"}
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["identified", "drafted", "sent", "touch_2", "touch_3", "replied_positive", "replied_negative", "no_response", "call_booked", "fit_call_done", "offer_sent", "won", "lost", "nurture", "rejected", "do_not_contact", "withdrawn"]
    }
  }
}
