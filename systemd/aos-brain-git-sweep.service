# Revisit: when Shared Brain Git recovery or alert routing changes. Last touched: 2026-10-03.
[Unit]
Description=TTROS Business Brain pending commit recovery
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/liam/agentic-os-live
Environment=PYTHONDONTWRITEBYTECODE=1
